#!/bin/bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[Pre-Commit] Running code formatting checks...${NC}"

# Get staged Java files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}[Pre-Commit] No Java files to format${NC}"
    exit 0
fi

echo -e "${YELLOW}[Pre-Commit] Formatting ${STAGED_FILES} with Spotless...${NC}"

# Format with Spotless
if mvn spotless:apply -q 2>/dev/null; then
    echo -e "${GREEN}[Pre-Commit] Formatting completed${NC}"

    # Re-stage formatted files
    echo "$STAGED_FILES" | xargs git add 2>/dev/null || true

    echo -e "${GREEN}[Pre-Commit] Files re-staged after formatting${NC}"
    exit 0
else
    echo -e "${RED}[Pre-Commit] Formatting failed${NC}"
    exit 1
fi
